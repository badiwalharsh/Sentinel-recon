# Environment Variables
# Copy to .env and configure your PostgreSQL database and authentication secrets

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinel_recon?schema=public"

# Auth.js / NextAuth Session Secret (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-32-character-random-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Application Config
NEXT_PUBLIC_APP_NAME="SentinelRecon"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

